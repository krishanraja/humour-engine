{
 "$defs": {
  "Budget": {
   "additionalProperties": false,
   "properties": {
    "max_cost_usd": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Cost Usd"
    },
    "max_input_tokens": {
     "default": 8000,
     "minimum": 0,
     "title": "Max Input Tokens",
     "type": "integer"
    },
    "max_model_calls": {
     "default": 2,
     "maximum": 20,
     "minimum": 0,
     "title": "Max Model Calls",
     "type": "integer"
    },
    "max_output_tokens": {
     "default": 2000,
     "minimum": 0,
     "title": "Max Output Tokens",
     "type": "integer"
    }
   },
   "title": "Budget",
   "type": "object"
  },
  "ContextBlock": {
   "additionalProperties": false,
   "properties": {
    "audience_description": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Audience Description"
    },
    "declared_intent": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "A caller-supplied statement of intent. Stored as a report with provenance.",
     "title": "Declared Intent"
    },
    "declared_intent_by": {
     "anyOf": [
      {
       "enum": [
        "speaker",
        "caller",
        "third_party"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Declared Intent By"
    },
    "known_references": {
     "items": {
      "type": "string"
     },
     "maxItems": 64,
     "title": "Known References",
     "type": "array"
    },
    "locale": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Locale"
    },
    "prior_segments": {
     "items": {
      "$ref": "#/$defs/Segment"
     },
     "maxItems": 64,
     "title": "Prior Segments",
     "type": "array"
    },
    "provided_facts": {
     "items": {
      "type": "string"
     },
     "maxItems": 64,
     "title": "Provided Facts",
     "type": "array"
    }
   },
   "title": "ContextBlock",
   "type": "object"
  },
  "Modality": {
   "enum": [
    "text",
    "transcript",
    "image",
    "audio",
    "video"
   ],
   "title": "Modality",
   "type": "string"
  },
  "ProviderPolicy": {
   "additionalProperties": false,
   "properties": {
    "allow_external_inference": {
     "default": false,
     "title": "Allow External Inference",
     "type": "boolean"
    },
    "allowed_provider_ids": {
     "items": {
      "type": "string"
     },
     "title": "Allowed Provider Ids",
     "type": "array"
    }
   },
   "title": "ProviderPolicy",
   "type": "object"
  },
  "Segment": {
   "additionalProperties": false,
   "properties": {
    "modality": {
     "$ref": "#/$defs/Modality",
     "default": "text"
    },
    "quoted_from": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Speaker ID of a quoted voice when this segment reports someone else's words.",
     "title": "Quoted From"
    },
    "segment_id": {
     "maxLength": 128,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9_.:-]+$",
     "title": "Segment Id",
     "type": "string"
    },
    "sequence": {
     "minimum": 0,
     "title": "Sequence",
     "type": "integer"
    },
    "speaker_id": {
     "anyOf": [
      {
       "maxLength": 128,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Speaker Id"
    },
    "text": {
     "maxLength": 8000,
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "segment_id",
    "text",
    "sequence"
   ],
   "title": "Segment",
   "type": "object"
  },
  "TaskName": {
   "enum": [
    "comprehension",
    "styles",
    "counterfactual",
    "profile_fit",
    "attribution"
   ],
   "title": "TaskName",
   "type": "string"
  }
 },
 "$id": "humour-engine/1.0/analysis_request.schema.json",
 "additionalProperties": false,
 "properties": {
  "budget": {
   "$ref": "#/$defs/Budget"
  },
  "context": {
   "$ref": "#/$defs/ContextBlock"
  },
  "counterfactual_variant": {
   "anyOf": [
    {
     "items": {
      "$ref": "#/$defs/Segment"
     },
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Optional supplied minimal edit of the focus segments for the counterfactual task.",
   "title": "Counterfactual Variant"
  },
  "focus_segment_ids": {
   "items": {
    "type": "string"
   },
   "minItems": 1,
   "title": "Focus Segment Ids",
   "type": "array"
  },
  "language": {
   "default": "en",
   "title": "Language",
   "type": "string"
  },
  "privacy_mode": {
   "default": "ephemeral",
   "enum": [
    "ephemeral",
    "retain"
   ],
   "title": "Privacy Mode",
   "type": "string"
  },
  "provider_policy": {
   "$ref": "#/$defs/ProviderPolicy"
  },
  "request_id": {
   "maxLength": 128,
   "minLength": 1,
   "title": "Request Id",
   "type": "string"
  },
  "schema_version": {
   "const": "1",
   "default": "1",
   "title": "Schema Version",
   "type": "string"
  },
  "segments": {
   "items": {
    "$ref": "#/$defs/Segment"
   },
   "maxItems": 64,
   "minItems": 1,
   "title": "Segments",
   "type": "array"
  },
  "tasks": {
   "items": {
    "$ref": "#/$defs/TaskName"
   },
   "title": "Tasks",
   "type": "array"
  },
  "taste_profile_id": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Taste Profile Id"
  }
 },
 "required": [
  "request_id",
  "focus_segment_ids",
  "segments"
 ],
 "title": "AnalysisRequest",
 "type": "object"
}
