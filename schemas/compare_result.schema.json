    "distribution": {
     "additionalProperties": {
      "type": "number"
     },
     "title": "Distribution",
     "type": "object"
    },
    "label_namespace": {
     "title": "Label Namespace",
     "type": "string"
    },
    "limitations": {
     "items": {
      "type": "string"
     },
     "title": "Limitations",
     "type": "array"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "predicted": {
     "title": "Predicted",
     "type": "string"
    },
    "uncertainty": {
     "$ref": "#/$defs/Uncertainty"
    }
   },
   "required": [
    "model",
    "label_namespace",
    "distribution",
    "predicted",
    "uncertainty"
   ],
   "title": "StylePrediction",
   "type": "object"
  },
  "TargetSubject": {
   "additionalProperties": false,
   "properties": {
    "perspective": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Perspective"
    },
    "subject": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Subject"
    },
    "target": {
     "default": "unknown",
     "enum": [
      "self",
      "other_person",
      "behaviour",
      "situation",
      "institution",
      "convention",
      "fictional_person",
      "none",
      "unknown"
     ],
     "title": "Target",
     "type": "string"
    }
   },
   "title": "TargetSubject",
   "type": "object"
  },
  "TaskName": {
   "enum": [
    "comprehension",
    "styles",
    "counterfactual",
    "profile_fit",
    "attribution"
   ],
   "title": "TaskName",
   "type": "string"
  },
  "TaskResult": {
   "additionalProperties": false,
   "properties": {
    "errors": {
     "items": {
      "$ref": "#/$defs/EngineError"
     },
     "title": "Errors",
     "type": "array"
    },
    "output_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Output Ref"
    },
    "status": {
     "$ref": "#/$defs/TaskStatus"
    },
    "task": {
     "$ref": "#/$defs/TaskName"
    }
   },
   "required": [
    "task",
    "status"
   ],
   "title": "TaskResult",
   "type": "object"
  },
  "TaskStatus": {
   "enum": [
    "complete",
    "abstained",
    "unsupported",
    "failed",
    "not_run"
   ],
   "title": "TaskStatus",
   "type": "string"
  },
  "Truncation": {
   "additionalProperties": false,
   "properties": {
    "occurred": {
     "default": false,
     "title": "Occurred",
     "type": "boolean"
    },
    "omitted_segments": {
     "items": {
      "type": "string"
     },
     "title": "Omitted Segments",
     "type": "array"
    },
    "potentially_lost_payoff": {
     "default": false,
     "title": "Potentially Lost Payoff",
     "type": "boolean"
    }
   },
   "title": "Truncation",
   "type": "object"
  },
  "Uncertainty": {
   "additionalProperties": false,
   "description": "Confidence is explicit about its kind. Unknown is null, never zero.",
   "properties": {
    "calibration_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Calibration Ref"
    },
    "notes": {
     "items": {
      "type": "string"
     },
     "title": "Notes",
     "type": "array"
    },
    "score": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Score"
    },
    "score_kind": {
     "default": "unknown",
     "enum": [
      "uncalibrated_model_score",
      "calibrated_probability",
      "unknown"
     ],
     "title": "Score Kind",
     "type": "string"
    }
   },
   "title": "Uncertainty",
   "type": "object"
  },
  "Usage": {
   "additionalProperties": false,
   "properties": {
    "calls": {
     "default": 0,
     "title": "Calls",
     "type": "integer"
    },
    "cost_status": {
     "default": "not_applicable",
     "enum": [
      "measured",
      "estimated",
      "unknown",
      "not_applicable"
