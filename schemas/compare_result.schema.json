    },
    "contextual_claim_refs": {
     "items": {
      "type": "string"
     },
     "title": "Contextual Claim Refs",
     "type": "array"
    },
    "counterevidence": {
     "items": {
      "type": "string"
     },
     "title": "Counterevidence",
     "type": "array"
    },
    "evidence_refs": {
     "items": {
      "type": "string"
     },
     "title": "Evidence Refs",
     "type": "array"
    },
    "expectations": {
     "items": {
      "type": "string"
     },
     "title": "Expectations",
     "type": "array"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "is_main": {
     "default": false,
     "title": "Is Main",
     "type": "boolean"
    },
    "labels_by_axis": {
     "additionalProperties": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": "Labels By Axis",
     "type": "object"
    },
    "literal_reading": {
     "title": "Literal Reading",
     "type": "string"
    },
    "reported_intent": {
     "anyOf": [
      {
       "$ref": "#/$defs/ReportedIntent"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "structure_kind": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Structure Kind"
    },
    "supported_reading": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Supported Reading"
    },
    "target_and_subject": {
     "$ref": "#/$defs/TargetSubject"
    },
    "triggers": {
     "items": {
      "type": "string"
     },
     "title": "Triggers",
     "type": "array"
    },
    "uncertainty": {
     "$ref": "#/$defs/Uncertainty"
    }
   },
   "required": [
    "id",
    "literal_reading"
   ],
   "title": "Interpretation",
   "type": "object"
  },
  "Modality": {
   "enum": [
    "text",
    "transcript",
    "image",
    "audio",
    "video"
   ],
   "title": "Modality",
   "type": "string"
  },
  "ReportedIntent": {
   "additionalProperties": false,
   "properties": {
    "basis": {
     "enum": [
      "direct_declaration",
      "second_hand_report",
      "inference"
     ],
     "title": "Basis",
     "type": "string"
    },
    "evidence_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Evidence Ref"
    },
    "reported_by": {
     "title": "Reported By",
     "type": "string"
    },
    "statement": {
     "title": "Statement",
     "type": "string"
    },
    "whose_intent": {
     "title": "Whose Intent",
     "type": "string"
    }
   },
   "required": [
    "whose_intent",
    "reported_by",
    "basis",
    "statement"
   ],
   "title": "ReportedIntent",
   "type": "object"
  },
  "ResultStatus": {
   "enum": [
    "complete",
    "partial",
    "abstained",
    "unsupported",
    "failed"
   ],
   "title": "ResultStatus",
   "type": "string"
  },
  "StylePrediction": {
   "additionalProperties": false,
   "description": "Source-specific social-function prediction. Not a comprehension result.",
