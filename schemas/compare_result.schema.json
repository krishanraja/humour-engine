{
 "$defs": {
  "AnalysisMode": {
   "enum": [
    "live",
    "local_model",
    "heuristic",
    "fixture"
   ],
   "title": "AnalysisMode",
   "type": "string"
  },
  "AnalysisResult": {
   "additionalProperties": false,
   "properties": {
    "analysis_id": {
     "title": "Analysis Id",
     "type": "string"
    },
    "analysis_mode": {
     "$ref": "#/$defs/AnalysisMode"
    },
    "attributions": {
     "items": {
      "$ref": "#/$defs/Attribution"
     },
     "title": "Attributions",
     "type": "array"
    },
    "audience_assessment": {
     "anyOf": [
      {
       "$ref": "#/$defs/AudienceAssessment"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "comic_reading": {
     "anyOf": [
      {
       "$ref": "#/$defs/ComicReading"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "context_dependencies": {
     "items": {
      "$ref": "#/$defs/ContextDependency"
     },
     "title": "Context Dependencies",
     "type": "array"
    },
    "counterfactual_analysis": {
     "anyOf": [
      {
       "$ref": "#/$defs/Counterfactual"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "errors": {
     "items": {
      "$ref": "#/$defs/EngineError"
     },
     "title": "Errors",
     "type": "array"
    },
    "evidence": {
     "items": {
      "$ref": "#/$defs/Evidence"
     },
     "title": "Evidence",
     "type": "array"
    },
    "humour_attempt": {
     "anyOf": [
      {
       "$ref": "#/$defs/HumourAttempt"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "input_revision": {
     "title": "Input Revision",
     "type": "string"
    },
    "interpretations": {
     "items": {
      "$ref": "#/$defs/Interpretation"
     },
     "title": "Interpretations",
     "type": "array"
    },
    "limitations": {
     "items": {
      "type": "string"
     },
     "title": "Limitations",
     "type": "array"
    },
    "missing_context": {
     "items": {
      "type": "string"
     },
     "title": "Missing Context",
     "type": "array"
    },
    "modalities_actually_processed": {
     "items": {
      "$ref": "#/$defs/Modality"
     },
     "title": "Modalities Actually Processed",
     "type": "array"
    },
    "request_id": {
     "title": "Request Id",
     "type": "string"
    },
    "requested_tasks": {
     "items": {
      "$ref": "#/$defs/TaskName"
     },
     "title": "Requested Tasks",
     "type": "array"
    },
    "schema_version": {
     "const": "1",
     "default": "1",
     "title": "Schema Version",
     "type": "string"
    },
    "status": {
     "$ref": "#/$defs/ResultStatus"
    },
    "style_prediction": {
     "anyOf": [
      {
       "$ref": "#/$defs/StylePrediction"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "task_results": {
     "items": {
      "$ref": "#/$defs/TaskResult"
     },
     "title": "Task Results",
     "type": "array"
    },
    "truncation": {
     "$ref": "#/$defs/Truncation"
    },
    "usage": {
     "$ref": "#/$defs/Usage"
    },
    "versions": {
     "$ref": "#/$defs/Versions"
    }
   },
   "required": [
    "analysis_id",
    "request_id",
    "input_revision",
    "versions",
    "analysis_mode",
    "requested_tasks",
    "task_results",
    "status"
   ],
   "title": "AnalysisResult",
   "type": "object"
  },
  "Attribution": {
   "additionalProperties": false,
   "properties": {
    "features": {
     "items": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
       {
        "type": "string"
       },
       {
        "type": "number"
       }
      ],
      "type": "array"
     },
     "title": "Features",
     "type": "array"
    },
    "fidelity": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Fidelity"
    },
    "limitations": {
     "items": {
      "type": "string"
     },
     "title": "Limitations",
     "type": "array"
    },
    "method": {
     "title": "Method",
     "type": "string"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "prediction": {
     "title": "Prediction",
     "type": "string"
    },
    "settings": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "integer"
       },
       {
        "type": "string"
       }
      ]
     },
     "title": "Settings",
     "type": "object"
    },
    "stability": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Stability"
    }
   },
   "required": [
    "model",
    "prediction",
    "method",
    "features",
    "settings",
    "fidelity"
   ],
   "title": "Attribution",
   "type": "object"
  },
  "AudienceAssessment": {
   "additionalProperties": false,
   "properties": {
    "basis": {
     "items": {
      "type": "string"
     },
     "title": "Basis",
     "type": "array"
    },
    "conflicting_example_ids": {
     "items": {
      "type": "string"
     },
     "title": "Conflicting Example Ids",
     "type": "array"
    },
    "fit": {
     "enum": [
      "match",
      "mismatch",
      "mixed",
      "unknown"
     ],
     "title": "Fit",
     "type": "string"
    },
    "limitations": {
     "items": {
      "type": "string"
     },
     "title": "Limitations",
     "type": "array"
    },
    "profile_id": {
     "title": "Profile Id",
     "type": "string"
    },
    "profile_version": {
     "title": "Profile Version",
     "type": "integer"
    },
    "scope": {
     "title": "Scope",
     "type": "string"
    },
    "score_kind": {
     "default": "descriptive_rule_fit",
     "enum": [
      "descriptive_rule_fit",
      "unknown"
     ],
     "title": "Score Kind",
     "type": "string"
    },
    "supporting_example_ids": {
     "items": {
      "type": "string"
     },
     "title": "Supporting Example Ids",
     "type": "array"
    },
    "uncertainty": {
     "$ref": "#/$defs/Uncertainty"
    }
   },
   "required": [
    "profile_id",
    "profile_version",
    "scope",
    "fit"
   ],
   "title": "AudienceAssessment",
   "type": "object"
  },
  "ComicReading": {
   "enum": [
    "supported",
    "not_supported",
    "ambiguous",
    "insufficient_context"
   ],
   "title": "ComicReading",
   "type": "string"
  },
  "ContextDependency": {
   "additionalProperties": false,
   "properties": {
    "claim": {
     "title": "Claim",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "required": {
     "default": false,
     "title": "Required",
     "type": "boolean"
    },
    "source_kind": {
     "enum": [
      "linguistic",
      "topical",
      "cultural",
      "interpersonal",
      "earlier_turn",
      "visual",
      "acoustic",
      "provided_fact"
     ],
     "title": "Source Kind",
     "type": "string"
    },
    "source_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Source Ref"
    },
    "verification_status": {
     "default": "unverified",
     "enum": [
      "supplied",
      "verified_in_input",
      "assumed",
      "unverified"
     ],
     "title": "Verification Status",
     "type": "string"
    }
   },
   "required": [
    "id",
    "claim",
    "source_kind"
   ],
   "title": "ContextDependency",
   "type": "object"
  },
  "Counterfactual": {
   "additionalProperties": false,
   "properties": {
    "expected_change": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Expected Change"
    },
    "human_validated": {
     "default": false,
     "title": "Human Validated",
     "type": "boolean"
    },
    "intervention": {
     "title": "Intervention",
     "type": "string"
    },
    "observed_change": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Observed Change"
    },
    "original_analysis_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Original Analysis Id"
    },
    "original_input_revision": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Original Input Revision"
    },
    "supplied_or_synthetic": {
     "enum": [
      "supplied",
      "synthetic"
     ],
     "title": "Supplied Or Synthetic",
     "type": "string"
    },
    "variant_analysis_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Variant Analysis Id"
    },
    "variant_input_revision": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Variant Input Revision"
    }
   },
   "required": [
    "supplied_or_synthetic",
    "intervention"
   ],
   "title": "Counterfactual",
   "type": "object"
  },
  "Difference": {
   "additionalProperties": false,
   "properties": {
    "a": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "A"
    },
    "b": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "B"
    },
    "dimension": {
     "title": "Dimension",
     "type": "string"
    },
    "grounded_in": {
     "description": "evidence or context ids from either analysis",
     "items": {
      "type": "string"
     },
     "title": "Grounded In",
     "type": "array"
    }
   },
   "required": [
    "dimension",
    "a",
    "b"
   ],
   "title": "Difference",
   "type": "object"
  },
  "EngineError": {
   "additionalProperties": false,
   "properties": {
    "code": {
     "title": "Code",
     "type": "string"
    },
    "message": {
     "title": "Message",
     "type": "string"
    },
    "retryable": {
     "default": false,
     "title": "Retryable",
     "type": "boolean"
    },
    "task": {
     "anyOf": [
      {
       "$ref": "#/$defs/TaskName"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "code",
    "message"
   ],
   "title": "EngineError",
   "type": "object"
  },
  "Evidence": {
   "additionalProperties": false,
   "properties": {
    "end": {
     "minimum": 0,
     "title": "End",
     "type": "integer"
    },
    "evidence_id": {
     "title": "Evidence Id",
     "type": "string"
    },
    "exact_text": {
     "title": "Exact Text",
     "type": "string"
    },
    "modality": {
     "$ref": "#/$defs/Modality",
     "default": "text"
    },
    "segment_id": {
     "title": "Segment Id",
     "type": "string"
    },
    "start": {
     "description": "Half-open Unicode code-point offset into the original segment text",
     "minimum": 0,
     "title": "Start",
     "type": "integer"
    }
   },
   "required": [
    "evidence_id",
    "segment_id",
    "start",
    "end",
    "exact_text"
   ],
   "title": "Evidence",
   "type": "object"
  },
  "HumourAttempt": {
   "additionalProperties": false,
   "properties": {
    "evidence_refs": {
     "items": {
      "type": "string"
     },
     "title": "Evidence Refs",
     "type": "array"
    },
    "limitations": {
     "items": {
      "type": "string"
     },
     "title": "Limitations",
     "type": "array"
    },
    "status": {
     "enum": [
      "reported",
      "supported_inference",
      "not_established"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "title": "HumourAttempt",
   "type": "object"
  },
  "Interpretation": {
   "additionalProperties": false,
   "properties": {
    "alternatives": {
     "items": {
      "type": "string"
     },
     "title": "Alternatives",
     "type": "array"
    },
    "connecting_logic": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
